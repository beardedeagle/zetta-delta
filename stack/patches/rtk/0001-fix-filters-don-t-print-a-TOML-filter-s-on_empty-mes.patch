diff --git a/tests/stderr_only_failure_test.rs b/tests/stderr_only_failure_test.rs
index 7a6e1ea..7e97aa5 100644
--- a/tests/stderr_only_failure_test.rs
+++ b/tests/stderr_only_failure_test.rs
@@ -178,3 +178,52 @@ fn lint_issues_are_summarised_and_exit_zero() {
         "exit 1 means issues found, which RTK reports without failing"
     );
 }
+
+/// TOML filters capture stdout only, too. mix-compile strips the `Compiling` line and
+/// prints its `on_empty` message, `mix compile: ok`, when nothing is left; a failed
+/// build leaves nothing there because its error went to stderr.
+#[test]
+fn toml_on_empty_is_not_claimed_for_a_failed_command() {
+    let dir = tempfile::tempdir().expect("tempdir");
+    fake_tool(
+        dir.path(),
+        "mix",
+        r#"echo "Compiling 1 file (.ex)"
+echo "** (CompileError) lib/broken.ex:2: undefined function nope/0" >&2
+exit 1"#,
+    );
+
+    let out = rtk_with(dir.path(), &["mix", "compile"]);
+    let stdout = String::from_utf8_lossy(&out.stdout);
+
+    assert!(
+        !stdout.contains("mix compile: ok"),
+        "a failed build must not be reported as ok; got stdout: {stdout}"
+    );
+    assert!(
+        String::from_utf8_lossy(&out.stderr).contains("CompileError"),
+        "the compiler's error must reach the user"
+    );
+    assert_eq!(out.status.code(), Some(1), "exit code must propagate");
+}
+
+/// The other half: a clean build still gets the filter's `on_empty` message.
+#[test]
+fn toml_on_empty_reports_a_clean_run() {
+    let dir = tempfile::tempdir().expect("tempdir");
+    fake_tool(
+        dir.path(),
+        "mix",
+        r#"echo "Compiling 1 file (.ex)"
+echo "Generated app app"
+exit 0"#,
+    );
+
+    let out = rtk_with(dir.path(), &["mix", "compile"]);
+
+    assert_eq!(
+        String::from_utf8_lossy(&out.stdout).trim(),
+        "mix compile: ok"
+    );
+    assert_eq!(out.status.code(), Some(0));
+}
