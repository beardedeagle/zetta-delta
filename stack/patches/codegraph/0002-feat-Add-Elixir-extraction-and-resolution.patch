 import { isTestPath } from '../search/query-utils';
 import { isMinifiedContent } from '../extraction/generated-detection';
 import { getCargoWorkspaceCrateMap } from './frameworks/cargo-workspace';
+
+/** Resolve only exact Elixir module/function identities supplied by lexical extraction. */
+export function matchElixirReference(ref: UnresolvedRef, context: ResolutionContext): ResolvedRef | null {
+  const calls = ref.referenceKind === 'calls';
+  let names = ref.candidates?.length ? ref.candidates : [ref.referenceName];
+  if (calls && !ref.candidates?.length && !ref.referenceName.includes('.')) {
+    const from = context.getNodeById?.(ref.fromNodeId);
+    const owner = from?.qualifiedName.slice(0, from.qualifiedName.lastIndexOf('::'));
+    names = owner ? [`${owner}.${ref.referenceName}`] : [];
+  }
+  const targets = new Map<string, Node>();
+  for (const name of names) {
+    const dot = calls ? name.lastIndexOf('.') : -1;
+    const canonical = dot > 0 ? `${name.slice(0, dot)}::${name.slice(dot + 1)}` : name;
+    for (const node of context.getNodesByQualifiedName(canonical)) {
+      if (node.language !== 'elixir') continue;
+      if (calls ? node.kind !== 'function' : !['module', 'protocol'].includes(node.kind)) continue;
+      // Private functions/macros are callable only within their declaring module.
+      if (calls && node.visibility === 'private') {
+        const from = context.getNodeById?.(ref.fromNodeId);
+        const owner = from?.qualifiedName.slice(0, from.qualifiedName.lastIndexOf('::'));
+        if (ref.referenceName.includes('.') || owner !== canonical.slice(0, canonical.lastIndexOf('::'))) continue;
+      }
+      targets.set(node.id, node);
+    }
+  }
+  if (targets.size !== 1) return null;
+  return { original: ref, targetNodeId: targets.keys().next().value!, confidence: 0.95, resolvedBy: 'qualified-name' };
+}
