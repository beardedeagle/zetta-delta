diff --git a/__tests__/elixir-graph.test.ts b/__tests__/elixir-graph.test.ts
new file mode 100644
index 0000000..b005158
--- /dev/null
+++ b/__tests__/elixir-graph.test.ts
@@ -0,0 +1,150 @@
+import { describe, it, expect } from 'vitest';
+import { mkdtempSync, writeFileSync, rmSync } from 'fs';
+import { join } from 'path';
+import { tmpdir } from 'os';
+import { CodeGraph } from '../src';
+
+describe('Elixir lexical graph', () => {
+  it('resolves static aliases, pipes, clauses, defaults and ExUnit without cross-module guesses', async () => {
+    const root = mkdtempSync(join(tmpdir(), 'codegraph-elixir-'));
+    let graph: CodeGraph | undefined;
+    try {
+      const files = {
+        'a.ex': `defmodule A.User do
+  def f(x), do: x
+  def g(x), do: x
+end
+`,
+        'b.ex': String.raw`defmodule B.User do
+  def f(x \\ 1)
+  def f(x) when is_integer(x), do: finish(x)
+  def f(x), do: finish(x)
+  def f(x, y), do: {x, y}
+  def finish(x), do: x
+  defp secret(x), do: x
+  def secret_local(x), do: secret(x)
+  def secret_remote(x), do: __MODULE__.secret(x)
+end
+`,
+        'caller.ex': `alias B.User, as: FileUser
+import B.User, only: [finish: 1]
+defmodule Caller do
+  alias B.User, as: User
+  def file_alias(x), do: FileUser.f(x)
+  def file_import(x), do: finish(x)
+  def run(x), do: x |> User.f() |> User.finish()
+  def zero(), do: User.f()
+  def wrong_arity(x), do: User.f(x, x, x)
+  def wrong_receiver(x), do: Missing.User.f(x)
+  def private_remote(x), do: User.secret(x)
+  def dynamic_remote(mod, x), do: mod.f(x)
+  def local_alias(x) do
+    alias A.User, as: User
+    User.f(x)
+  end
+  def after_alias(x), do: User.f(x)
+  def undefined_local(x), do: unknown(x)
+  def scoped(x) do
+    if x do
+      alias A.User, as: User
+      User.f(x)
+    end
+    User.f(x)
+  end
+end
+`,
+        'blocks.ex': `defmodule Blocks do
+  def wrapper(), do: :zero
+  def wrapper(opts), do: opts
+  def wrapper(x, opts), do: {x, opts}
+  def block() do
+    wrapper do
+      :ok
+    end
+  end
+  def piped(x) do
+    x |> wrapper do
+      :ok
+    end
+  end
+end
+`,
+        'import.ex': `defmodule Imported do
+  import B.User, only: [finish: 1]
+  def imported(x), do: finish(x)
+  def not_imported(x), do: f(x)
+end
+defmodule Reimported do
+  import A.User, only: [f: 1]
+  def run(x) do
+    import A.User, only: [g: 1]
+    import B.User, only: [f: 1]
+    f(x)
+  end
+end
+`,
+        'nested.ex': `defmodule Outer do
+  defmodule Inner do
+    def own(x), do: x
+  end
+  def nested(x), do: Inner.own(x)
+  defprotocol P do
+    def render(x)
+  end
+  def render(x), do: P.render(x)
+end
+defmodule Elsewhere do
+  def nested(x), do: Outer.Inner.own(x)
+end
+`,
+        'caller_test.exs': `defmodule CallerTest do
+  use ExUnit.Case
+  alias Caller, as: Pipeline
+  describe "pipeline" do
+    test "routes a value" do
+      assert Pipeline.run(2) == 2
+    end
+  end
+end
+`,
+      };
+      for (const [name, source] of Object.entries(files)) writeFileSync(join(root, name), source);
+      graph = await CodeGraph.init(root, { index: true });
+      graph.resolveReferences();
+      const all = graph.getNodesByKind('function');
+      const node = (name: string) => { const n = all.find((n) => n.qualifiedName === name); expect(n, name).toBeDefined(); return n!; };
+      const callees = (name: string) => graph!.getCallees(node(name).id).filter((r) => r.edge.kind === 'calls').map((r) => r.node.qualifiedName).sort();
+      expect(callees('Caller::file_alias/1')).toEqual(['B.User::f/1']);
+      expect(callees('Caller::file_import/1')).toEqual(['B.User::finish/1']);
+      expect(callees('Caller::run/1')).toEqual(['B.User::f/1', 'B.User::finish/1']);
+      expect(callees('Caller::zero/0')).toEqual(['B.User::f/0']);
+      expect(callees('B.User::f/0')).toEqual(['B.User::f/1']);
+      expect(callees('B.User::f/1')).toEqual(['B.User::finish/1']);
+      expect(callees('B.User::secret_local/1')).toEqual(['B.User::secret/1']);
+      expect(callees('B.User::secret_remote/1')).toEqual([]);
+      expect(node('B.User::f/1').endLine).toBe(4);
+      expect(callees('Caller::local_alias/1')).toEqual(['A.User::f/1']);
+      expect(callees('Caller::after_alias/1')).toEqual(['B.User::f/1']);
+      expect(callees('Caller::scoped/1')).toEqual(['A.User::f/1', 'B.User::f/1']);
+      for (const name of ['wrong_arity/1', 'wrong_receiver/1', 'private_remote/1', 'dynamic_remote/2', 'undefined_local/1']) {
+        expect(callees(`Caller::${name}`), name).toEqual([]);
+      }
+      expect(callees('Blocks::block/0')).toEqual(['Blocks::wrapper/1']);
+      expect(callees('Blocks::piped/1')).toEqual(['Blocks::wrapper/2']);
+      expect(callees('Imported::imported/1')).toEqual(['B.User::finish/1']);
+      expect(callees('Imported::not_imported/1')).toEqual([]);
+      expect(callees('Reimported::run/1')).toEqual(['B.User::f/1']);
+      expect(callees('Outer::nested/1')).toEqual(['Outer.Inner::own/1']);
+      expect(callees('Outer::render/1')).toEqual(['Outer.P::render/1']);
+      expect(graph.getNodesByKind('protocol').some((n) => n.qualifiedName === 'Outer.P')).toBe(true);
+      expect(callees('Elsewhere::nested/1')).toEqual(['Outer.Inner::own/1']);
+      expect(callees('CallerTest::test pipeline routes a value')).toEqual(['Caller::run/1']);
+      expect(graph.getCallers(node('Caller::run/1').id).some((r) => r.node.filePath === 'caller_test.exs')).toBe(true);
+      const module = graph.getNodesByKind('module').find((n) => n.name === 'B.User')!;
+      expect(graph.getCallers(module.id).some((r) => r.edge.kind === 'imports')).toBe(true);
+    } finally {
+      graph?.close();
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+});
