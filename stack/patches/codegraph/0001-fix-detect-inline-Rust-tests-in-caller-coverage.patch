diff --git a/codegraph-kernel/src/rustlang.rs b/codegraph-kernel/src/rustlang.rs
index 1dbc689..4a8aab8 100644
--- a/codegraph-kernel/src/rustlang.rs
+++ b/codegraph-kernel/src/rustlang.rs
@@ -287,6 +287,31 @@ impl<'t> Walker<'t> {
         let sig_ref = opt_str(&mut self.arena, extra.signature.as_deref());
         let decorators_ref = opt_str(&mut self.arena, extra.decorators.as_deref());
         let ret_ref = opt_str(&mut self.arena, extra.return_type.as_deref());
+        // Match rustExtractor.extractModifiers: only an attached #[test]
+        // marks the function, never its neighbors or its containing module.
+        // The wasm walker applies it when the node is created, and its later
+        // Tauri-command scan (carried here in extra.decorators) replaces the
+        // list, so a decorator from extract_fn_or_method takes precedence.
+        let mut decorators = decorators_ref;
+        if extra.decorators.is_none() && node.kind() == "function_item" {
+            let mut sibling = node.prev_named_sibling();
+            while let Some(attr) = sibling {
+                match attr.kind() {
+                    "line_comment" | "block_comment" => {}
+                    "attribute_item" => {
+                        let is_test = (0..attr.named_child_count())
+                            .filter_map(|i| attr.named_child(i))
+                            .any(|value| value.kind() == "attribute" && self.text(value).trim() == "test");
+                        if is_test {
+                            decorators = self.arena.put_list(&["test".to_string()]);
+                            break;
+                        }
+                    }
+                    _ => break,
+                }
+                sibling = attr.prev_named_sibling();
+            }
+        }
         let row = self.tables.push_node(&NodeRow {
             kind: node_kind_index(kind).unwrap(),
             visibility: extra.visibility.unwrap_or(0),
@@ -300,7 +325,7 @@ impl<'t> Walker<'t> {
