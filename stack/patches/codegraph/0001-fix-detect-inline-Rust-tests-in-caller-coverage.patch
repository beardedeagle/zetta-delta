diff --git a/src/search/query-utils.ts b/src/search/query-utils.ts
index 03817b8..d5ce3c3 100644
--- a/src/search/query-utils.ts
+++ b/src/search/query-utils.ts
@@ -300,6 +300,12 @@ export function isTestFile(filePath: string): boolean {
   return isTestPath(filePath) || matchesNonProductionDir(filePath.toLowerCase());
