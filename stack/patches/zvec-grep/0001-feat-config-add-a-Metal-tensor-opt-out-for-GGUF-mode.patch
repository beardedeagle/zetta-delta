+test("global config accepts an explicit Metal tensor workaround and rejects non-booleans", async (t) => {
+  const directory = await mkdtemp(join(tmpdir(), "zvec-grep-metal-config-"));
+  const configPath = join(directory, "config.json");
+  t.after(() => rm(directory, { recursive: true, force: true }));
+
+  for (const disableMetalTensor of [true, false]) {
+    updateGlobalConfig({ defaults: { disableMetalTensor } }, configPath);
+    assert.equal(
+      readGlobalConfig(configPath).defaults.disableMetalTensor,
+      disableMetalTensor,
+    );
+  }
+  for (const disableMetalTensor of ["true", 1, null]) {
+    await writeFile(
+      configPath,
+      JSON.stringify({ version: 1, defaults: { disableMetalTensor } }),
+    );
+    assert.throws(
+      () => readGlobalConfig(configPath),
+      (error) => {
+        assert.equal(error.code, "ZVEC_GREP.ENGINE.CONFIG.INVALID");
+        assert.match(
+          error.context,
+          /defaults\.disableMetalTensor must be a boolean/,
+        );
+        return true;
+      },
+    );
+  }
+});
+
