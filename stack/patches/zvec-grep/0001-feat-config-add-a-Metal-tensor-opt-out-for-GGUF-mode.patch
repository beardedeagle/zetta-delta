index ad438cc..ef13cb5 100644
--- a/src/engine/config.ts
+++ b/src/engine/config.ts
@@ -7,6 +7,8 @@ import { acquireReadWriteLock } from "./utils/lock.js";
 export type ZvecGrepGlobalDefaults = {
   embedding?: string;
   modelCacheDir?: string;
+  /** Skip unsupported optional Metal tensor kernels; Metal GPU offload stays enabled. */
+  disableMetalTensor?: boolean;
 };
 
 export type ZvecGrepProviderConfig = {
@@ -323,7 +325,20 @@ function parseDefaults(
   if (!isRecord(value)) {
     throw invalidConfig(path, "defaults must be an object");
   }
-  assertKnownFields(value, ["embedding", "modelCacheDir"], path, "defaults");
+  assertKnownFields(
+    value,
+    ["embedding", "modelCacheDir", "disableMetalTensor"],
+    path,
+    "defaults",
+  );
+
+  const disableMetalTensor = value.disableMetalTensor;
+  if (
+    disableMetalTensor !== undefined &&
+    typeof disableMetalTensor !== "boolean"
+  ) {
+    throw invalidConfig(path, "defaults.disableMetalTensor must be a boolean");
+  }
 
   const embedding = optionalNonEmptyString(
     value.embedding,
@@ -338,6 +353,7 @@ function parseDefaults(
   const defaults: ZvecGrepGlobalDefaults = {
     ...(embedding ? { embedding } : {}),
     ...(modelCacheDir ? { modelCacheDir } : {}),
+    ...(disableMetalTensor !== undefined ? { disableMetalTensor } : {}),
   };
   return Object.keys(defaults).length > 0 ? defaults : undefined;
 }
