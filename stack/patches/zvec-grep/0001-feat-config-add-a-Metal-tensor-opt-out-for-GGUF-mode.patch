   const moduleName = "node-llama-cpp";
+  installDarwinMetalRuntimeMitigations();
   try {
-    installDarwinMetalResidencyMitigation();
     return (await import(moduleName)) as NodeLlamaCppModule;
   } catch (cause) {
     throw new EngineError(
@@ -109,16 +110,20 @@ async function defaultNodeLlamaCppLoader(): Promise<NodeLlamaCppModule> {
   }
 }
 
-function installDarwinMetalResidencyMitigation(): void {
+function installDarwinMetalRuntimeMitigations(): void {
   if (process.platform !== "darwin") {
     return;
   }
 
-  if (process.env.ZVEC_GREP_METAL_KEEP_RESIDENCY === "1") {
-    return;
+  // The native backend is process-global, so this is a host default, not a
+  // per-model setting. Leave tensor support unchanged unless explicitly disabled.
+  if (readGlobalConfig().defaults?.disableMetalTensor === true) {
+    process.env.GGML_METAL_TENSOR_DISABLE ??= "1";
   }
 
-  process.env.GGML_METAL_NO_RESIDENCY ??= "1";
+  if (process.env.ZVEC_GREP_METAL_KEEP_RESIDENCY !== "1") {
+    process.env.GGML_METAL_NO_RESIDENCY ??= "1";
+  }
 }
 
 let defaultRuntimeImport: Promise<NodeLlamaCppModule> | null = null;
diff --git a/test/config.test.mjs b/test/config.test.mjs
index 172a913..cc7eb1e 100644
--- a/test/config.test.mjs
+++ b/test/config.test.mjs
