+
+function parseGitInventory(content: string): IgnoreRule[] | null {
+  let value: unknown;
+  try {
+    value = JSON.parse(content);
+  } catch {
+    return null; // Ordinary ignore files retain their existing parser.
+  }
+  if (
+    !value ||
+    typeof value !== "object" ||
+    !("zettaDeltaGitInventory" in value)
+  ) {
+    return null;
+  }
+  const inventory = value as Record<string, unknown>;
+  const validPaths = (paths: unknown): paths is string[] =>
+    Array.isArray(paths) &&
+    paths.every(
+      (path) =>
+        typeof path === "string" &&
+        path.length > 0 &&
+        !path.includes("\0") &&
+        !path.startsWith("/") &&
+        !path
+          .replace(/\/$/, "")
+          .split("/")
+          .some((part) => !part || part === "." || part === ".."),
+    );
+  if (
+    inventory.zettaDeltaGitInventory !== ZETTA_DELTA_GIT_INVENTORY_VERSION ||
+    !validPaths(inventory.ignored) ||
+    !validPaths(inventory.tracked)
+  ) {
+    throw new Error("Invalid exact Git path inventory");
+  }
+  const trackedDirectories = new Set<string>();
+  for (const path of inventory.tracked) {
+    const parts = path.split("/");
+    for (let depth = 1; depth < parts.length; depth++) {
+      trackedDirectories.add(parts.slice(0, depth).join("/"));
+    }
+  }
+  return [
+    {
+      basePath: "",
+      pattern: "",
+      negated: false,
+      directoryOnly: false,
+      anchored: true,
+      hasSlash: true,
+      gitInventory: {
+        ignored: new Set(inventory.ignored.filter((path) => !path.endsWith("/"))),
+        ignoredDirectories: new Set(
+          inventory.ignored
+            .filter((path) => path.endsWith("/"))
+            .map((path) => path.slice(0, -1)),
+        ),
+        tracked: new Set(inventory.tracked),
+        trackedDirectories,
+      },
+    },
+  ];
 }
 
