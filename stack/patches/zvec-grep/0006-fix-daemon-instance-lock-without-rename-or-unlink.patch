+function serializeInstanceRecord(record: DaemonInstanceRecord): string {
+  const payload = `${JSON.stringify(record)}\n`;
+  return payload.length < INSTANCE_RECORD_WIDTH
+    ? payload.padEnd(INSTANCE_RECORD_WIDTH, " ")
+    : payload;
+}
+
+function isReplacementDenied(error: unknown): boolean {
+  const code = (error as NodeJS.ErrnoException | undefined)?.code;
+  return (
+    code === "EPERM" ||
+    code === "EACCES" ||
+    code === "EXDEV" ||
+    code === "ENOTSUP" ||
+    code === "EBUSY"
+  );
+}
+
+async function writeRecordInPlace(
+  path: string,
+  payload: string,
+): Promise<void> {
+  const handle = await open(path, "r+");
+  try {
+    await handle.write(payload, 0, "utf8");
+    const { size } = await handle.stat();
+    if (size > payload.length) {
+      await handle.truncate(payload.length);
+    }
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+}
+
+async function takeOverInstanceRecord(
+  path: string,
+  record: DaemonInstanceRecord,
+): Promise<boolean> {
+  try {
+    await writeRecordInPlace(path, serializeInstanceRecord(record));
+    return true;
+  } catch {
+    return false;
   }
