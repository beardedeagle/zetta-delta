+test("concurrent stale instance takeovers select exactly one owner", async () => {
+  const home = await fs.mkdtemp(join(tmpdir(), "zg-instance-stale-"));
+  const locks = [];
+  try {
+    await fs.mkdir(join(home, "daemon"));
+    await fs.writeFile(join(home, "daemon/instance.lock"), JSON.stringify({
+      pid: 0, hostname: hostname(), instanceToken: "stale", startedAt: 1,
+      updatedAt: 1, serverUrl: "http://127.0.0.1:1/mcp", ready: false,
+      mcpToolset: "agent",
+    }));
+    const outcomes = await Promise.allSettled(Array.from({ length: 8 }, () =>
+      DaemonInstanceLock.acquire(home, "http://127.0.0.1:1/mcp")));
+    for (const outcome of outcomes) {
+      if (outcome.status === "fulfilled") locks.push(outcome.value);
+    }
+    assert.equal(locks.length, 1);
+    assert.equal((await readInstanceRecord(home)).instanceToken,
+      locks[0].record.instanceToken);
+    assert.deepEqual(await fs.readdir(join(home, "daemon")), ["instance.lock"]);
+  } finally {
+    for (const lock of locks) await lock.release();
+    await fs.rm(home, { recursive: true, force: true });
+  }
+});
+
+test("released records can be taken over when instance unlink is denied", async () => {
+  const home = await fs.mkdtemp(join(tmpdir(), "zg-instance-released-"));
+  const first = await DaemonInstanceLock.acquire(home, "http://127.0.0.1:1/mcp");
+  const originalUnlink = fs.unlink;
+  let second;
+  try {
+    fs.unlink = async (path) => {
+      if (path === join(home, "daemon/instance.lock")) {
+        throw Object.assign(new Error("unlink denied"), { code: "EPERM" });
+      }
+      return originalUnlink(path);
+    };
+    syncBuiltinESMExports();
+    await first.release();
+    assert.equal((await readInstanceRecord(home)).pid, 0);
+    second = await DaemonInstanceLock.acquire(home, "http://127.0.0.1:1/mcp");
+    await second.markReady();
+    assert.equal((await readInstanceRecord(home)).instanceToken,
+      second.record.instanceToken);
+    assert.equal((await readInstanceRecord(home)).ready, true);
+  } finally {
+    fs.unlink = originalUnlink;
+    syncBuiltinESMExports();
+    await second?.release();
+    await first.release();
+    await fs.rm(home, { recursive: true, force: true });
+  }
+});
