+
+async function exists(path) {
+  try {
+    await fs.access(path);
+    return true;
+  } catch (error) {
+    if (error.code !== "ENOENT") throw error;
+    return false;
+  }
+}
+
+async function waitFor(check) {
+  const deadline = Date.now() + 5_000;
+  while (!(await check())) {
+    if (Date.now() >= deadline) throw new Error("guard worker timed out");
+    await delay(5);
+  }
+}
+
+const worker = `
+import fs from "node:fs";
+import promises from "node:fs/promises";
+import { syncBuiltinESMExports } from "node:module";
+import { join } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+const [home, id, module] = process.argv.slice(1);
+const signal = name => join(home, id + "." + name);
+const read = fs.readFileSync;
+const readAsync = promises.readFile;
+let guardPaused = false;
+let recordPaused = false;
+fs.readFileSync = (...args) => {
+  const result = read(...args);
+  if (!guardPaused && args[0] === join(home, "daemon/instance.guard/owner.json")) {
+    guardPaused = true;
+    fs.writeFileSync(signal("guard"), "");
+    const deadline = Date.now() + 5_000;
+    while (!fs.existsSync(signal("go-guard"))) {
+      if (Date.now() >= deadline) throw new Error("guard barrier timed out");
+      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 5);
+    }
+  }
+  return result;
+};
+promises.readFile = async (...args) => {
+  const result = await readAsync(...args);
+  if (!recordPaused && args[0] === join(home, "daemon/instance.lock")) {
+    recordPaused = true;
+    fs.writeFileSync(signal("record"), "");
+    const deadline = Date.now() + 5_000;
+    while (!fs.existsSync(signal("go-record"))) {
+      if (Date.now() >= deadline) throw new Error("record barrier timed out");
+      await delay(5);
+    }
+  }
+  return result;
+};
+syncBuiltinESMExports();
+const { DaemonInstanceLock } = await import(module);
+let lock;
+let result;
+try {
+  lock = await DaemonInstanceLock.acquire(home, "http://127.0.0.1:1/mcp");
+  result = { acquired: true, token: lock.record.instanceToken };
+} catch (error) {
+  result = { acquired: false, error: error.message };
+}
+fs.writeFileSync(signal("result.tmp"), JSON.stringify(result));
+fs.renameSync(signal("result.tmp"), signal("result"));
+const deadline = Date.now() + 5_000;
+while (!fs.existsSync(signal("release"))) {
+  if (Date.now() >= deadline) throw new Error("release barrier timed out");
+  await delay(5);
+}
+await lock?.release();
+`;
+
+test("two processes cannot steal a new owner while reclaiming a stale instance guard", async (t) => {
+  const home = await fs.mkdtemp(join(tmpdir(), "zg-stale-guard-"));
+  const children = [];
+  t.after(async () => {
+    for (const id of ["a", "b"]) {
+      for (const name of ["go-guard", "go-record", "release"]) {
+        await fs.writeFile(join(home, id + "." + name), "");
+      }
+    }
+    for (const child of children) {
+      if (child.exitCode === null && child.signalCode === null) {
+        const exited = once(child, "exit");
+        child.kill("SIGKILL");
+        await exited;
+      }
+    }
+    await fs.rm(home, { recursive: true, force: true });
+  });
+  const stale = { pid: 0, hostname: hostname(), instanceToken: "stale",
+    startedAt: 1, createdAt: 1, updatedAt: 1,
+    serverUrl: "http://127.0.0.1:1/mcp", ready: false, mcpToolset: "agent" };
+  await fs.mkdir(join(home, "daemon/instance.guard"), { recursive: true });
+  await fs.writeFile(join(home, "daemon/instance.guard/owner.json"), JSON.stringify(stale));
+  await fs.writeFile(join(home, "daemon/instance.lock"), JSON.stringify(stale));
+  const module = new URL("../dist/daemon/server-controller.js", import.meta.url).href;
+  for (const id of ["a", "b"]) {
+    children.push(spawn(process.execPath, ["--input-type=module", "-e", worker, home, id, module],
+      { stdio: "ignore" }));
+  }
+  await waitFor(async () => await exists(join(home, "a.guard")) && await exists(join(home, "b.guard")));
+  await fs.writeFile(join(home, "a.go-guard"), "");
+  await waitFor(() => exists(join(home, "a.record")));
+  await fs.writeFile(join(home, "b.go-guard"), "");
+  await waitFor(async () => await exists(join(home, "b.record")) || await exists(join(home, "b.result")));
+  await fs.writeFile(join(home, "a.go-record"), "");
+  await fs.writeFile(join(home, "b.go-record"), "");
+  await waitFor(async () => await exists(join(home, "a.result")) && await exists(join(home, "b.result")));
+  const results = await Promise.all(["a", "b"].map(async (id) =>
+    JSON.parse(await fs.readFile(join(home, id + ".result"), "utf8"))));
+  assert.equal(results.filter(result => result.acquired).length, 1);
+  const current = JSON.parse(await fs.readFile(join(home, "daemon/instance.lock"), "utf8"));
+  assert.equal(current.instanceToken, results.find(result => result.acquired).token);
+});
+
+test("releasing an old guard preserves a replacement owner's directory", async () => {
+  const home = await fs.mkdtemp(join(tmpdir(), "zg-guard-release-"));
+  const path = join(home, "guard");
+  const first = acquireDaemonLeaseGuardAtPath(path, "first");
+  let second;
+  try {
+    assert.ok(first);
+    await fs.rename(path, join(home, "old-guard"));
+    second = acquireDaemonLeaseGuardAtPath(path, "second");
+    assert.ok(second);
+    const names = await fs.readdir(path);
+    const before = await Promise.all(names.map(name => fs.readFile(join(path, name), "utf8")));
+    first.release();
+    assert.deepEqual(await fs.readdir(path), names);
+    assert.deepEqual(await Promise.all(names.map(name => fs.readFile(join(path, name), "utf8"))), before);
+  } finally {
+    first?.release();
+    second?.release();
+    await fs.rm(home, { recursive: true, force: true });
+  }
+});
+
+test("abandoned empty guards recover and recent incomplete guards remain held", async () => {
+  const home = await fs.mkdtemp(join(tmpdir(), "zg-empty-guard-"));
