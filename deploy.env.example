# Template for deploy.env, which git ignores: copy it, fill in your values,
# then install with
#   . ./deploy.env && ./install.sh --force
# Provider ids are "custom:" + sha256 of each provider's base URL (README,
# "Find your provider ids"). They are not secrets; they change if a base URL
# changes.
# ./install.sh --help lists every setting.
export KIMI_PROVIDER='custom:<sha256 of the base URL>'    # Kimi Code
export ZAI_PROVIDER='custom:<sha256 of the base URL>'     # Z.AI Coding Plan
export QWEN_PROVIDER='custom:<sha256 of the base URL>'    # Qwen Cloud Token Plan
export ZAI_TIER=lite QWEN_TIER=lite                       # your real tiers
# Optional lanes:
# export MINIMAX_PROVIDER='custom:<sha256 of the base URL>' MINIMAX_BILLING=plan  # or metered
# export GPT_PROVIDER=openai-subscribed                 # ChatGPT subscription (built in)
# export GROK_PROVIDER=x_ai-subscribed                  # Grok subscription (built in)
# export COPILOT_PROVIDER=<id>
# export LOCAL_PROVIDER=<id> LOCAL_MODEL=<served model id>
# export THREAD_CAP=6    # Settings > Subagents > Max Agents Per Thread (Overall: twice this)
# export METERED_LANES="DeepSeek API, OpenCode Zen"

# Built-in model overrides must carry truthful lane metadata. Known plan and
# subscription lanes infer provider/billing/shared limit from the inputs above.
# An API lane needs its actual provider id and explicit concurrency limit:
# export BUILTIN_WORKER_MODEL=deepseek-v4-pro BUILTIN_WORKER_FAMILY=DeepSeek
# export BUILTIN_WORKER_LANE="DeepSeek API" BUILTIN_WORKER_PROVIDER='custom:<sha256 of the base URL>'
# export BUILTIN_WORKER_LIMIT=1                 # billing is inferred as metered
# For a new lane, also declare billing; all roles on one lane must agree:
# export BUILTIN_REVIEWER_MODEL='served-model-id' BUILTIN_REVIEWER_FAMILY=GLM
# export BUILTIN_REVIEWER_LANE='Private lane' BUILTIN_REVIEWER_PROVIDER='custom:<sha256 of the base URL>'
# export BUILTIN_REVIEWER_BILLING=flat BUILTIN_REVIEWER_LIMIT=1
# The same PROVIDER/BILLING/LIMIT settings apply to BUILTIN_SCOUT.
# Metered built-ins are excluded from default flat candidates; an explicitly
# user-named metered candidate still requires the skill's spending opt-in.
